'use client';

import React, { useState, useEffect } from 'react';
import { createClient } from '@supabase/supabase-js';

// Initialize Supabase Client
// Ensure NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY are set in .env.local
const supabase = createClient(
  process.env.NEXT_PUBLIC_SUPABASE_URL || '',
  process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY || ''
);

// Types matching database schema
interface Player {
  id: string;
  full_name: string;
  email: string;
  is_student: boolean;
}

interface Session {
  id: string;
  session_date: string;
  court_count: number;
  fee_per_player: number;
  max_capacity: number;
  status: string;
}

interface AttendanceRecord {
  id: string;
  session_id: string;
  player_id: string;
  status: 'attending' | 'waitlisted' | 'absent' | 'cancelled';
  checked_in_at: string | null;
  players: Player;
}

interface PaymentRecord {
  id: string;
  player_id: string;
  session_id: string;
  amount: number;
  payment_method: 'stripe' | 'bank_transfer' | 'cash';
  status: 'pending' | 'paid' | 'refunded';
  paid_at: string | null;
  players: Player;
}

export default function AdminDashboard() {
  const [sessions, setSessions] = useState<Session[]>([]);
  const [selectedSessionId, setSelectedSessionId] = useState<string>('');
  const [attendance, setAttendance] = useState<AttendanceRecord[]>([]);
  const [payments, setPayments] = useState<PaymentRecord[]>([]);
  const [activeTab, setActiveTab] = useState<'attendance' | 'payments'>('attendance');
  const [loading, setLoading] = useState<boolean>(true);
  const [actionLoading, setActionLoading] = useState<string | null>(null);

  // 1. Fetch all sessions on initial load
  useEffect(() => {
    async function loadSessions() {
      setLoading(true);
      const { data, error } = await supabase
        .from('sessions')
        .select('*')
        .order('session_date', { ascending: false });

      if (error) {
        console.error('Error fetching sessions:', error.message);
      } else if (data && data.length > 0) {
        setSessions(data);
        setSelectedSessionId(data[0].id); // Default to most recent session
      }
      setLoading(false);
    }

    loadSessions();
  }, []);

  // 2. Fetch attendance & payments when selected session changes
  useEffect(() => {
    if (!selectedSessionId) return;

    async function fetchSessionDetails() {
      setLoading(true);

      // Fetch attendance with joined player data
      const { data: attData, error: attError } = await supabase
        .from('attendance')
        .select('*, players(id, full_name, email, is_student)')
        .eq('session_id', selectedSessionId)
        .order('created_at', { ascending: true });

      if (attError) console.error('Error fetching attendance:', attError.message);
      else setAttendance((attData as AttendanceRecord[]) || []);

      // Fetch payments with joined player data
      const { data: payData, error: payError } = await supabase
        .from('payments')
        .select('*, players(id, full_name, email, is_student)')
        .eq('session_id', selectedSessionId);

      if (payError) console.error('Error fetching payments:', payError.message);
      else setPayments((payData as PaymentRecord[]) || []);

      setLoading(false);
    }

    fetchSessionDetails();
  }, [selectedSessionId]);

  // Handle Court Check-In Toggle
  const handleCheckInToggle = async (recordId: string, currentCheckIn: string | null) => {
    setActionLoading(recordId);
    const newCheckIn = currentCheckIn ? null : new Date().toISOString();

    const { error } = await supabase
      .from('attendance')
      .update({ checked_in_at: newCheckIn })
      .eq('id', recordId);

    if (!error) {
      setAttendance((prev) =>
        prev.map((item) => (item.id === recordId ? { ...item, checked_in_at: newCheckIn } : item))
      );
    } else {
      alert(`Check-in failed: ${error.message}`);
    }
    setActionLoading(null);
  };

  // Handle Marking Payment as Paid (Bank Transfer / Cash)
  const handleMarkAsPaid = async (paymentId: string, method: 'bank_transfer' | 'cash') => {
    setActionLoading(paymentId);
    const now = new Date().toISOString();

    const { error } = await supabase
      .from('payments')
      .update({
        status: 'paid',
        payment_method: method,
        paid_at: now,
      })
      .eq('id', paymentId);

    if (!error) {
      setPayments((prev) =>
        prev.map((item) =>
          item.id === paymentId
            ? { ...item, status: 'paid', payment_method: method, paid_at: now }
            : item
        )
      );
    } else {
      alert(`Payment update failed: ${error.message}`);
    }
    setActionLoading(null);
  };

  // Derived Stats
  const currentSession = sessions.find((s) => s.id === selectedSessionId);
  const totalAttending = attendance.filter((a) => a.status === 'attending').length;
  const totalCheckedIn = attendance.filter((a) => a.checked_in_at !== null).length;
  const totalExpectedRevenue = payments.reduce((acc, p) => acc + Number(p.amount), 0);
  const totalCollectedRevenue = payments
    .filter((p) => p.status === 'paid')
    .reduce((acc, p) => acc + Number(p.amount), 0);

  return (
    <div className="min-h-screen bg-slate-50 p-4 md:p-8 text-slate-800">
      <div className="max-w-7xl mx-auto space-y-6">
        
        {/* Header & Session Selector */}
        <div className="flex flex-col md:flex-row md:items-center md:justify-between gap-4 bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
          <div>
            <h1 className="text-2xl font-bold text-slate-900">Badminton Club Admin</h1>
            <p className="text-sm text-slate-500">Manage court check-ins and session payment ledger</p>
          </div>

          <div className="flex items-center gap-3">
            <label htmlFor="session-select" className="text-sm font-semibold text-slate-600">
              Session Date:
            </label>
            <select
              id="session-select"
              value={selectedSessionId}
              onChange={(e) => setSelectedSessionId(e.target.value)}
              className="px-4 py-2 bg-slate-50 border border-slate-300 rounded-lg font-medium text-slate-800 focus:outline-none focus:ring-2 focus:ring-emerald-500"
            >
              {sessions.map((s) => (
                <option key={s.id} value={s.id}>
                  {new Date(s.session_date).toLocaleDateString('en-GB', {
                    weekday: 'short',
                    day: 'numeric',
                    month: 'short',
                    year: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit',
                  })}
                </option>
              ))}
            </select>
          </div>
        </div>

        {/* Stats Grid */}
        <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <div className="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
            <p className="text-xs font-semibold uppercase tracking-wider text-slate-400">Court Capacity</p>
            <p className="text-2xl font-extrabold text-slate-900 mt-1">
              {totalAttending} / {currentSession?.max_capacity || 0}
            </p>
            <p className="text-xs text-slate-500 mt-1">{currentSession?.court_count || 0} Courts Allocated</p>
          </div>

          <div className="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
            <p className="text-xs font-semibold uppercase tracking-wider text-slate-400">Court Check-Ins</p>
            <p className="text-2xl font-extrabold text-emerald-600 mt-1">
              {totalCheckedIn} / {totalAttending}
            </p>
            <p className="text-xs text-slate-500 mt-1">Players scanned/checked-in</p>
          </div>

          <div className="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
            <p className="text-xs font-semibold uppercase tracking-wider text-slate-400">Collected Revenue</p>
            <p className="text-2xl font-extrabold text-slate-900 mt-1">
              £{totalCollectedRevenue.toFixed(2)}
            </p>
            <p className="text-xs text-slate-500 mt-1">Target: £{totalExpectedRevenue.toFixed(2)}</p>
          </div>

          <div className="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
            <p className="text-xs font-semibold uppercase tracking-wider text-slate-400">Unpaid Invoices</p>
            <p className="text-2xl font-extrabold text-amber-600 mt-1">
              {payments.filter((p) => p.status === 'pending').length}
            </p>
            <p className="text-xs text-slate-500 mt-1">Awaiting bank/cash check</p>
          </div>
        </div>

        {/* Tabs & Content Area */}
        <div className="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
          
          {/* Tab Navigation */}
          <div className="flex border-b border-slate-200 bg-slate-50/50">
            <button
              onClick={() => setActiveTab('attendance')}
              className={`px-6 py-4 text-sm font-semibold border-b-2 transition-colors ${
                activeTab === 'attendance'
                  ? 'border-emerald-600 text-emerald-600 bg-white'
                  : 'border-transparent text-slate-500 hover:text-slate-800'
              }`}
            >
              Attendance Roster ({attendance.length})
            </button>
            <button
              onClick={() => setActiveTab('payments')}
              className={`px-6 py-4 text-sm font-semibold border-b-2 transition-colors ${
                activeTab === 'payments'
                  ? 'border-emerald-600 text-emerald-600 bg-white'
                  : 'border-transparent text-slate-500 hover:text-slate-800'
              }`}
            >
              Payment Reconciliation ({payments.length})
            </button>
          </div>

          {/* Loading Skeleton */}
          {loading ? (
            <div className="p-12 text-center text-slate-400 font-medium">Loading session records...</div>
          ) : (
            <div>
              {/* TAB 1: ATTENDANCE */}
              {activeTab === 'attendance' && (
                <div className="overflow-x-auto">
                  <table className="w-full text-left border-collapse">
                    <thead>
                      <tr className="bg-slate-50 text-slate-500 text-xs uppercase tracking-wider border-b border-slate-200">
                        <th className="py-3 px-6 font-semibold">Player</th>
                        <th className="py-3 px-6 font-semibold">Type</th>
                        <th className="py-3 px-6 font-semibold">RSVP Status</th>
                        <th className="py-3 px-6 font-semibold">Checked In Time</th>
                        <th className="py-3 px-6 font-semibold text-right">Action</th>
                      </tr>
                    </thead>
                    <tbody className="divide-y divide-slate-100 text-sm">
                      {attendance.length === 0 ? (
                        <tr>
                          <td colSpan={5} className="py-8 text-center text-slate-400">
                            No attendance records for this session.
                          </td>
                        </tr>
                      ) : (
                        attendance.map((row) => (
                          <tr key={row.id} className="hover:bg-slate-50/80 transition-colors">
                            <td className="py-4 px-6">
                              <p className="font-semibold text-slate-900">{row.players?.full_name}</p>
                              <p className="text-xs text-slate-400">{row.players?.email}</p>
                            </td>
                            <td className="py-4 px-6">
                              {row.players?.is_student ? (
                                <span className="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-indigo-50 text-indigo-700 border border-indigo-200">
                                  Student (Discount)
                                </span>
                              ) : (
                                <span className="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-slate-100 text-slate-600">
                                  Standard
                                </span>
                              )}
                            </td>
                            <td className="py-4 px-6">
                              <span
                                className={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${
                                  row.status === 'attending'
                                    ? 'bg-emerald-100 text-emerald-800'
                                    : row.status === 'waitlisted'
                                    ? 'bg-amber-100 text-amber-800'
                                    : 'bg-rose-100 text-rose-800'
                                }`}
                              >
                                {row.status}
                              </span>
                            </td>
                            <td className="py-4 px-6 text-slate-500 text-xs">
                              {row.checked_in_at
                                ? new Date(row.checked_in_at).toLocaleTimeString([], {
                                    hour: '2-digit',
                                    minute: '2-digit',
                                  })
                                : '—'}
                            </td>
                            <td className="py-4 px-6 text-right">
                              <button
                                disabled={actionLoading === row.id}
                                onClick={() => handleCheckInToggle(row.id, row.checked_in_at)}
                                className={`px-3 py-1.5 rounded-lg text-xs font-semibold transition-all shadow-sm ${
                                  row.checked_in_at
                                    ? 'bg-slate-200 hover:bg-slate-300 text-slate-700'
                                    : 'bg-emerald-600 hover:bg-emerald-700 text-white'
                                }`}
                              >
                                {actionLoading === row.id
                                  ? 'Saving...'
                                  : row.checked_in_at
                                  ? 'Undo Check-In'
                                  : 'Check In Court-Side'}
                              </button>
                            </td>
                          </tr>
                        ))
                      )}
                    </tbody>
                  </table>
                </div>
              )}

              {/* TAB 2: PAYMENTS */}
              {activeTab === 'payments' && (
                <div className="overflow-x-auto">
                  <table className="w-full text-left border-collapse">
                    <thead>
                      <tr className="bg-slate-50 text-slate-500 text-xs uppercase tracking-wider border-b border-slate-200">
                        <th className="py-3 px-6 font-semibold">Player</th>
                        <th className="py-3 px-6 font-semibold">Amount</th>
                        <th className="py-3 px-6 font-semibold">Payment Method</th>
                        <th className="py-3 px-6 font-semibold">Status</th>
                        <th className="py-3 px-6 font-semibold text-right">Mark Received</th>
                      </tr>
                    </thead>
                    <tbody className="divide-y divide-slate-100 text-sm">
                      {payments.length === 0 ? (
                        <tr>
                          <td colSpan={5} className="py-8 text-center text-slate-400">
                            No payment invoices generated for this session yet.
                          </td>
                        </tr>
                      ) : (
                        payments.map((p) => (
                          <tr key={p.id} className="hover:bg-slate-50/80 transition-colors">
                            <td className="py-4 px-6">
                              <p className="font-semibold text-slate-900">{p.players?.full_name}</p>
                              {p.players?.is_student && (
                                <span className="text-xs text-indigo-600 font-medium">
                                  Student rate applied
                                </span>
                              )}
                            </td>
                            <td className="py-4 px-6 font-bold text-slate-900">
                              £{Number(p.amount).toFixed(2)}
                            </td>
                            <td className="py-4 px-6 capitalize text-slate-600 text-xs">
                              {p.payment_method.replace('_', ' ')}
                            </td>
                            <td className="py-4 px-6">
                              <span
                                className={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${
                                  p.status === 'paid'
                                    ? 'bg-emerald-100 text-emerald-800'
                                    : p.status === 'pending'
                                    ? 'bg-amber-100 text-amber-800'
                                    : 'bg-slate-100 text-slate-600'
                                }`}
                              >
                                {p.status}
                              </span>
                            </td>
                            <td className="py-4 px-6 text-right space-x-2">
                              {p.status === 'pending' ? (
                                <>
                                  <button
                                    disabled={actionLoading === p.id}
                                    onClick={() => handleMarkAsPaid(p.id, 'bank_transfer')}
                                    className="px-2.5 py-1.5 bg-blue-50 hover:bg-blue-100 text-blue-700 text-xs font-semibold rounded-md border border-blue-200 transition-colors"
                                  >
                                    Bank Transfer
                                  </button>
                                  <button
                                    disabled={actionLoading === p.id}
                                    onClick={() => handleMarkAsPaid(p.id, 'cash')}
                                    className="px-2.5 py-1.5 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 text-xs font-semibold rounded-md border border-emerald-200 transition-colors"
                                  >
                                    Cash
                                  </button>
                                </>
                              ) : (
                                <span className="text-xs text-slate-400">
                                  Paid {p.paid_at ? new Date(p.paid_at).toLocaleDateString() : ''}
                                </span>
                              )}
                            </td>
                          </tr>
                        ))
                      )}
                    </tbody>
                  </table>
                </div>
              )}
            </div>
          )}
        </div>
      </div>
    </div>
  );
}
